{
  "manifest_version": 3,
  "name": "Media Controls",
  "version": "1.0.0",
  "description": "Control the media playing in your tabs from the toolbar: play/pause, skip 5 seconds and seek.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Media controls",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
